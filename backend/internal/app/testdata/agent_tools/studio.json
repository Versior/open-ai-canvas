  {
    "function": {
      "description": "排或改一套方案，按权限模式审批后写入。kind=main 用 main-* 角色（通常白底、卖点、场景、细节、多角度共 5 张）；kind=detail 用 detail-* 角色（通常 8–12 屏，按品类安排顺序）。action=replace 新建整套镜头（已出过图的方案不能替换）；action=update 按 shotId 改标题、画幅、图上文案与微调。图上文案只用已确认的事实和卖点，不写价格与极限词；不提交生成任务。",
      "name": "studio_plan_shots",
      "parameters": {
        "additionalProperties": false,
        "properties": {
          "action": {
            "enum": [
              "replace",
              "update"
            ],
            "type": "string"
          },
          "kind": {
            "description": "main=主图套图，detail=一键详情页",
            "enum": [
              "main",
              "detail"
            ],
            "type": "string"
          },
          "platform": {
            "enum": [
              "taobao",
              "jd",
              "pdd",
              "douyin",
              "xiaohongshu",
              "amazon",
              "walmart",
              "etsy",
              "tiktokshop",
              "shopify"
            ],
            "type": "string"
          },

                  "enum": [
                    "main-white",
                    "main-selling",
                    "main-scene",
                    "main-detail",
                    "main-angle",
                    "detail-hero",
                    "detail-selling",
                    "detail-model",
                    "detail-scene",
                    "detail-material",
                    "detail-closeup",
                    "detail-angles",
                    "detail-spec",
                    "detail-size",
                    "detail-package",
                    "detail-closing"
                  ],
                  "type": "string"
                },
                "sellingPointIds": {
                  "description": "这张图表达的 pointId",
